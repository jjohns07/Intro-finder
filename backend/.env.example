PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h

# Skrapp is the default provider. Missing credentials disable discovery gracefully.
DISCOVERY_PROVIDER=skrapp
SKRAPP_API_KEY=
# Headcount enrichment costs up to 3 credits per company/category on first retrieval.
SKRAPP_EXECUTIVE_SEARCH_ENABLED=true
# Default free-plan limits, per backend process. Use your actual account limits.
SKRAPP_SEARCH_REQUESTS_PER_MINUTE=20
SKRAPP_SEARCH_REQUESTS_PER_DAY=50
# Selected company profiles: cache up to 1 hour (0 disables caching).
# Provider no-store/no-cache and shorter max-age directives always take priority.
SKRAPP_COMPANY_CACHE_TTL_SECONDS=3600
# On Render only: verify one reference company and its executives after startup.
# The check uses at most 3 credits on first retrieval and never prints credentials.
SKRAPP_VERIFY_ON_STARTUP=true
# Also check four company profiles after the initial Render probe succeeds.
# At most 4 extra first-retrieval credits; report is in logs and /api/health.
# Works on free Render plans without Shell. Set false to disable this extra check.
SKRAPP_VERIFY_COMPANY_INFORMATION=true

# Optional legacy PDL adapter, selected with DISCOVERY_PROVIDER=pdl.
PDL_API_KEY=
# Set true only when your PDL agreement permits this app's display and saved snapshots.
PDL_ALLOW_RESULT_STORAGE=false
# Requires Person Search access/credits in addition to Company Search.
PDL_PERSON_SEARCH_ENABLED=false
# Per endpoint, per backend process. Do not exceed your account's allowance.
PDL_REQUESTS_PER_MINUTE=10
